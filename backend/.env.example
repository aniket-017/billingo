# Neon PostgreSQL — use the *pooler* host for the running app (hostname contains -pooler)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Use the *non-pooler* host for: npx prisma migrate deploy
# DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
#
# If you see E57P01 "terminating connection due to administrator command":
# Neon suspended the DB or closed an idle connection — restart npm run dev, or retry the request.

PORT=1975
JWT_SECRET=change-me-in-production-use-a-long-random-string

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=bookstore_invoice
WHATSAPP_SHOP_CONTACT=+91 8421630880
INVOICE_BASE_URL=https://your-domain.com

NODE_ENV=development
