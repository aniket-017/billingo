# Neon PostgreSQL (use pooled URL for DATABASE_URL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Optional: direct connection for migrations (Neon recommends this with pooler)
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

PORT=1970
JWT_SECRET=change-me-in-production-use-a-long-random-string

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=bookstore_invoice
WHATSAPP_SHOP_CONTACT=+91 8421630880
INVOICE_BASE_URL=https://your-domain.com

NODE_ENV=development
