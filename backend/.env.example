# Neon PostgreSQL — use the *pooler* host for the running app (hostname contains -pooler)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Use the *non-pooler* host for: npx prisma migrate deploy
# DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
#
# If you see E57P01 "terminating connection due to administrator command":
# Neon suspended the DB or closed an idle connection — restart npm run dev, or retry the request.

PORT=1975
JWT_SECRET=change-me-in-production-use-a-long-random-string

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=myVerifyToken123
WHATSAPP_TEMPLATE_NAME=bookstore_invoice
WHATSAPP_SHOP_CONTACT=+91 8421630880

# AWS S3 — invoice PDF storage (private bucket; WhatsApp uses presigned URLs)
AWS_REGION=eu-north-1
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional:
# AWS_S3_INVOICE_PREFIX=businesses
# AWS_S3_PRESIGN_EXPIRY_SECONDS=604800

NODE_ENV=development

# Product name extraction from OCR label text (mobile scan flow)
PRODUCT_NAME_AI_PROVIDER=google
# Allowed: google | deepseek
# Optional: override provider for bulk-import "Send Photo to AI" only
# INVOICE_IMAGE_AI_PROVIDER=google

# Google Gemini — get key at https://aistudio.google.com/api-keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# DeepSeek — alternative provider
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
